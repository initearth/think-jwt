{
    "name": "initearth/think-jwt",
    "description": "基于 firebase/php-jwt ^7.2 的 ThinkPHP 8.0+ JWT 验证",
    "keywords": [
        "auth",
        "authentication",
        "php-jwt",
        "jwt",
        "thinkphp"
    ],
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "initearth",
            "homepage": "https://github.com/initearth"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../think-response",
            "options": {
                "symlink": true,
                "versions": {
                    "initearth/think-response": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../think-enum",
            "options": {
                "symlink": true,
                "versions": {
                    "initearth/think-enum": "dev-main"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0.0",
        "firebase/php-jwt": "^7.2",
        "initearth/think-response": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "think\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "think": {
            "config": {
                "jwt": "config/config.php"
            }
        }
    }
}
